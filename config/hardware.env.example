# Copy to config/local.env. Use interface names verified against the physical arms.
export NERO_LEFT_LEADER_CAN=can_ml
export NERO_LEFT_FOLLOWER_CAN=can_sl
export NERO_RIGHT_LEADER_CAN=can_mr
export NERO_RIGHT_FOLLOWER_CAN=can_sr
export ROS_DOMAIN_ID=0

